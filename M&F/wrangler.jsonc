{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "speedtest-mf",
  "main": "./worker.js",
  "compatibility_date": "2026-11-26",
  "kv_namespaces": [
    {
      "binding": "MF_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "CACHE_TTL_SECONDS": "60"
  }
}
